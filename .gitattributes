# One line-ending rule for everyone (the repo is edited on Windows and committed as LF): without this,
# core.autocrlf makes whole files look changed and causes false merge conflicts.
* text=auto eol=lf

# Never touched by line-ending conversion.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.xlsx binary
*.zip binary

# The lockfile is generated: on a merge conflict take main's copy and run `pnpm install`, never hand-merge.
pnpm-lock.yaml -diff
