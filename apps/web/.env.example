# Variable names only (02_TRD.md §33). Copy to .env.local and fill in values — never commit real values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only — never expose to the client (TRD §20)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_EVIDENCE=
SUPABASE_STORAGE_BUCKET_REPORTS=

# Report PDFs (TRD §17). Unset in production (Vercel): @sparticuz/chromium supplies the browser. Locally,
# point it at an installed Chromium-family browser, e.g. Edge or Chrome.
CHROMIUM_EXECUTABLE_PATH=

# Database (direct Postgres access): server-side transactional mutations and scripts/provision-user.ts.
# Server-only. On Vercel use Supabase's transaction-mode pooler (port 6543).
DATABASE_URL=

# Error tracking (instrumentation.ts): server-side errors go to Sentry when this is set; unset, nothing is
# sent. Server-only.
SENTRY_DSN=

# The address people reach the app at, used for links in emails (no trailing slash). Unset on Vercel, the
# project's production address is used; unset elsewhere, http://localhost:3000.
NEXT_PUBLIC_APP_URL=

# Email over Brevo's SMTP relay: invitation links (Invite user, bulk import), password-reset codes,
# reminders. BREVO_API_KEY holds the SMTP key (xsmtpsib-…), not the REST key. BREVO_SENDER_EMAIL must be a
# sender verified in Brevo. BREVO_SMTP_LOGIN is the SMTP login when it differs from the sender address.
# Left unset, accounts are still created — the email is skipped and the screen says so.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
BREVO_SMTP_LOGIN=
# Local development only: send the app's email to a mail catcher on this machine instead of Brevo (the local
# Supabase stack's is 127.0.0.1:55325, read at http://127.0.0.1:55324). Honoured only for a loopback
# address, so it can never point a deployed app's email somewhere else.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=

# ESG data analyst chatbot (.grill/chat-analyst-decisions.md). Server-only, all four; with any of the first
# three unset the chatbot is off and its buttons are not shown.
# NVIDIA_NIM_MODEL is one model or a comma-separated list tried in order when a model is rate limited, out
# of quota or unavailable. Use models that support tool calling.
# NVIDIA_NIM_BASE_URL is optional (default https://integrate.api.nvidia.com/v1); point it at a locally
# served OpenAI-compatible model to keep every question inside the network.
# CHAT_DATABASE_URL connects as the read-only role chat_reader (migration 0042), never as the main user.
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=
NVIDIA_NIM_BASE_URL=
CHAT_DATABASE_URL=

# General
NODE_ENV=
