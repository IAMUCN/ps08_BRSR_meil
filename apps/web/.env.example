# Variable names only (02_TRD.md §33). Copy to .env.local and fill in values — never commit real values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only — never expose to the client (TRD §20)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_EVIDENCE=
SUPABASE_STORAGE_BUCKET_REPORTS=

# Report PDFs (TRD §17). Unset in production (Vercel): @sparticuz/chromium supplies the browser. Locally,
# point it at an installed Chromium-family browser, e.g. Edge or Chrome.
CHROMIUM_EXECUTABLE_PATH=

# Database (direct Postgres access): server-side transactional mutations and scripts/provision-user.ts.
# Server-only. On Vercel use Supabase's transaction-mode pooler (port 6543).
DATABASE_URL=

# Error tracking
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Email (P1)
RESEND_API_KEY=

# Auth
AUTH_SECRET=

# General
NODE_ENV=
