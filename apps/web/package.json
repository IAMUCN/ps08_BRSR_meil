{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"tests/**/*.test.ts\"",
    "provision-user": "node --env-file-if-exists=.env.local scripts/provision-user.ts",
    "validate-pending": "node --conditions=react-server --env-file-if-exists=.env.local scripts/validate-pending.ts",
    "calculate-pending": "node --conditions=react-server --env-file-if-exists=.env.local scripts/calculate-pending.ts",
    "test:e2e": "node tests/e2e/run.mjs"
  },
  "dependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "@trpc/server": "11.18.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "nodemailer": "^10.0.10",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "postgres": "3.4.9",
    "puppeteer-core": "^25.11.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "2.0.8",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "^3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
