# Variable names only (02_TRD.md §33). Copy to .env and fill in values — never commit real values.
# The worker talks to the app only through Supabase Postgres + Storage (TRD §22); no app secret is needed.

# Supabase (TRD §33 defines this single URL variable name for the project)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_EVIDENCE=

# Database (direct Postgres access for job polling). Hosted: Supabase "Session pooler" connection string.
DATABASE_URL=

# OCR worker
OCR_MODEL_PATH=
OCR_WORKER_POLL_INTERVAL_MS=

# Error tracking
SENTRY_DSN=
